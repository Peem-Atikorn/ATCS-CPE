# Copy to .env for local development. Never commit real credentials.
AGENT_VERSION=0.1.0
PROMPT_VERSION=rules-v1
# Must equal AGENT_SERVICE_TOKEN in Module 02. Empty disables auth (local dev only).
AGENT_SERVICE_TOKEN=
DECISION_SERVICE_URL=http://localhost:8050
# false: real Module 04 transport/disaster + Module 05 integration. Other tools remain mock.
USE_MOCK_TOOLS=false
# Required for live TomTom transport. GDACS needs no key.
TOMTOM_API_KEY=
MAX_AGENT_STEPS=12
MAX_TOOL_CALLS=20
AGENT_TOTAL_TIMEOUT=60
TOOL_TIMEOUT_SECONDS=5
DECISION_MAX_ATTEMPTS=2
# Planned for the LLM planner (not used yet):
# LLM_MODEL_PLANNER=
# LLM_API_KEY=
# LLM_TIMEOUT_SECONDS=10
AGENT_HOST_PORT=8010
