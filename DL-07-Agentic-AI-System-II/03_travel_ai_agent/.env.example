# Copy to .env for local development. Never commit real credentials.
AGENT_VERSION=0.1.0
PROMPT_VERSION=rules-v1
# Must equal AGENT_SERVICE_TOKEN in Module 02. Empty disables auth (local dev only).
AGENT_SERVICE_TOKEN=
DECISION_SERVICE_URL=http://localhost:8050
# Modules 04/05/06 have no services yet, so the agent uses synthetic mock tools.
USE_MOCK_TOOLS=true
MAX_AGENT_STEPS=12
MAX_TOOL_CALLS=20
AGENT_TOTAL_TIMEOUT=30
TOOL_TIMEOUT_SECONDS=5
DECISION_MAX_ATTEMPTS=2
# Planned for the LLM planner (not used yet):
# LLM_MODEL_PLANNER=
# LLM_API_KEY=
# LLM_TIMEOUT_SECONDS=10
AGENT_HOST_PORT=8010
