# Backend (02_api_backend) configuration example.
# Copy to .env for local runs outside Docker. Never commit .env.
# Every tunable value (P-xx) has a default in app/core/config.py; set it here only to override.

# ---------------------------------------------------------------- required
APP_ENV=dev
DATABASE_URL=postgresql+asyncpg://tsa:tsa@localhost:5432/tsa
REDIS_URL=redis://localhost:6379/0
JWT_ISSUER=http://localhost:8000/dev-issuer
JWT_AUDIENCE=travel-safety-api
AGENT_SERVICE_URL=http://localhost:8010
CORS_ALLOWED_ORIGINS=http://localhost:3000
OTEL_EXPORTER_OTLP_ENDPOINT=
LOG_LEVEL=INFO

# ---------------------------------------------------------------- optional
LOG_JSON=false
ENABLE_DOCS=true
REDIS_CACHE_URL=redis://localhost:6380/0
CELERY_BROKER_URL=redis://localhost:6379/2
JWKS_URL=
# Dev/test only. Must stay empty in staging/prod.
DEV_JWT_SIGNING_KEY=
AGENT_CLIENT_ID=
AGENT_CLIENT_SECRET=

# ---------------------------------------------------------------- docker compose host ports
API_HOST_PORT=8000
POSTGRES_HOST_PORT=5432
REDIS_CORE_HOST_PORT=6379
REDIS_CACHE_HOST_PORT=6380

# ---------------------------------------------------------------- tunable examples (P-xx)
# SYNC_AGENT_TIMEOUT_SECONDS=8
# RATE_LIMIT_RECOMMEND=10
# RETENTION_FEEDBACK_DAYS=180
