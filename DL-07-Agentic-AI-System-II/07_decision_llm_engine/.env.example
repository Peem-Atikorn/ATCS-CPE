# Copy to .env for local development. Never commit real credentials.
DECISION_POLICY_VERSION=prototype-v1
# The bundled prototype policy cannot be approved by changing this flag.
POLICY_APPROVED=false
PROMPT_VERSION=v1
# No live provider is implemented yet. Templates work without an API key.
LLM_API_KEY=
LLM_MODEL_EXPLAINER=disabled
TEMPERATURE=0
MAX_INPUT_TOKENS=8000
MAX_OUTPUT_TOKENS=1500
LLM_TIMEOUT=5
LLM_MAX_ATTEMPTS=2
SUPPORTED_LOCALES=th-TH,en-US
ESCALATION_RULES=missing,stale,conflicting,incomplete,low_confidence,unverified_warning
# Local Python path; Compose deliberately uses /app/data/audit.jsonl instead.
AUDIT_LOG_PATH=data/audit.jsonl
DECISION_HOST_PORT=8050
